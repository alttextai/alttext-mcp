{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alttextai/alttext-mcp",
  "description": "Generate alt text, translate descriptions, and manage your AltText.ai image library.",
  "repository": {
    "url": "https://github.com/alttextai/alttext-mcp",
    "source": "github"
  },
  "version": "1.0.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@alttext_ai/alttext-mcp",
      "version": "1.0.5",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ALTTEXT_API_KEY",
          "description": "Your AltText.ai API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "ALTTEXT_API_BASE_URL",
          "description": "Optional API base URL override for proxies or alternate endpoints",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
