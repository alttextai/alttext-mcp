{
  "name": "alttext-toolkit",
  "version": "1.0.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "format": "prettier --write 'packages/*/{src,test}/**/*.ts' 'packages/*/tsup.config.ts' 'scripts/*.mjs'",
    "format:check": "prettier --check 'packages/*/{src,test}/**/*.ts' 'packages/*/tsup.config.ts' 'scripts/*.mjs'",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:stamp": "node scripts/stamp-version.mjs",
    "version:check": "node scripts/stamp-version.mjs --check",
    "check": "npm run version:check && npm run lint && npm run format:check && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.2.3",
    "@types/oidc-provider": "9.12.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "shx": "^0.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
