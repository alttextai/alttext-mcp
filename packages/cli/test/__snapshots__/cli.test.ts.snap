exports[`help > images generate --help matches its snapshot 1`] = `
"Usage: alttext images generate [options]

Generate AI-powered alt text for an image URL. Returns the result synchronously (may take a few
seconds). Uses account credits; additional languages and image conversion can increase the total.
Can overwrite existing alt text when requested.

Options:
  --url <value>                Public URL of the image
  --asset-id <value>           Custom asset ID (default: auto-generated hash)
  --lang <value>               Comma-separated language codes (e.g. 'en', 'en,fr,es')
  --keywords <value>           Keywords to incorporate (repeatable)
  --negative-keywords <value>  Keywords to avoid (repeatable)
  --gpt-prompt <value>         Custom prompt template. Use {{AltText}} as a placeholder for the
                               generated alt text.
  --max-chars <n>              Maximum character length for the alt text
  --overwrite                  Overwrite existing alt text if image was previously processed
  --no-overwrite               Set overwrite to false
  --tags <value>               Tags for organization (repeatable)
  --metadata <key=value>       Custom metadata (string key-value pairs) (repeatable)
  -h, --help                   Show help

Global Options:
  -v, --version                Print the version
  --json                       Print the result as JSON on stdout
  --no-input                   Never prompt; fail instead when input is needed
  --yes                        Run destructive commands without asking for confirmation
  --dry-run                    Read the target and show what a change would do, without making it
  --show-tokens                Show full tokens in keys list and keys get
"
`;

exports[`help > images generate-from-file --help matches its snapshot 1`] = `
