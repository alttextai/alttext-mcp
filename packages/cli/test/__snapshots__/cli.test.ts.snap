exports[`help > alttext --help matches its snapshot 1`] = `
"Usage: alttext [options] [command]

Command-line tool for AltText.ai

Options:
  -v, --version  Print the version
  --json         Print the result as JSON on stdout
  --no-input     Never prompt; fail instead when input is needed
  --yes          Run destructive commands without asking for confirmation
  --dry-run      Read the target and show what a change would do, without making it
  --show-tokens  Show full tokens in keys list and keys get
  -h, --help     Show help

Commands:
  login          Store an API key after checking it works. Reads the key from a hidden prompt, or
                 from stdin when piped
  logout         Remove the stored API key from the OS keychain and the credentials file
  whoami         Show the account, the key's kind, what it can do and where it came from
  account        View and update your account
  images         Generate, find and manage alt text for images
  pages          Find a web page's images and queue alt text for them
  keys           Create, rotate, revoke and inspect the account's site API keys
"
`;

exports[`help > images --help matches its snapshot 1`] = `
"Usage: alttext images [options] [command]

Generate, find and manage alt text for images

Options:
  -h, --help                      Show help

Global Options:
  -v, --version                   Print the version
  --json                          Print the result as JSON on stdout
  --no-input                      Never prompt; fail instead when input is needed
  --yes                           Run destructive commands without asking for confirmation
  --dry-run                       Read the target and show what a change would do, without making it
  --show-tokens                   Show full tokens in keys list and keys get

Commands:
  generate [options]              Generate AI-powered alt text for an image URL. Returns the result
                                  synchronously (may take a few seconds). Uses account credits;
                                  additional languages and image conversion can increase the total.
                                  Can overwrite existing alt text when requested.
  generate-from-file [options]    Generate alt text from a local image file. Reads a file on the MCP
                                  server machine and uploads it to AltText.ai. Uses account credits;
                                  additional languages and image conversion can increase the total.
                                  Can overwrite existing alt text when requested.
  translate [options] <asset-id>  Add alt text in a new language for an existing image. Uses the
                                  asset_id to find the image and generates a translation. Uses
                                  account credits for each newly generated language.
  list [options]                  List images in your AltText.ai library with pagination
  search [options]                Search images by alt text content
  get [options] <asset-id>        Get details for a specific image by its asset ID
  update [options] <asset-id>     Update alt text and/or metadata for an existing image
  delete <asset-id>               Delete an image from your AltText.ai library
  bulk-create [options]           Upload a local CSV file from the MCP server machine and queue
                                  asynchronous alt-text generation using account credits. The
                                  response does not confirm generation completion. CSV should have
                                  columns: url (required), asset_id, lang, keywords, tags, metadata
                                  (optional).
"
`;

exports[`help > images bulk-create --help matches its snapshot 1`] = `
"Usage: alttext images bulk-create [options]

Upload a local CSV file from the MCP server machine and queue asynchronous alt-text generation using
account credits. The response does not confirm generation completion. CSV should have columns: url
(required), asset_id, lang, keywords, tags, metadata (optional).

Options:
  --csv-file <value>  Path to CSV file with image URLs and optional metadata
  --email <value>     Email for completion notification
  -h, --help          Show help

Global Options:
  -v, --version       Print the version
  --json              Print the result as JSON on stdout
  --no-input          Never prompt; fail instead when input is needed
  --yes               Run destructive commands without asking for confirmation
  --dry-run           Read the target and show what a change would do, without making it
  --show-tokens       Show full tokens in keys list and keys get
"
`;

