// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help > account --help matches its snapshot 1`] = `
"Usage: alttext account [options] [command]

View and update your account

Options:
  -h, --help        Show help

Global Options:
  -v, --version     Print the version
  --json            Print the result as JSON on stdout
  --no-input        Never prompt; fail instead when input is needed
  --yes             Run destructive commands without asking for confirmation
  --dry-run         Read the target and show what a change would do, without making it
  --show-tokens     Show full tokens in keys list and keys get

Commands:
  get               Get your AltText.ai account info including credit balance, usage, and settings
  update [options]  Update your AltText.ai account settings (name, webhook URL, notification email)
"
`;

