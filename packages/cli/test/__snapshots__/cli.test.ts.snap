  --yes                   Run destructive commands without asking for confirmation
  --dry-run               Read the target and show what a change would do, without making it
  --show-tokens           Show full tokens in keys list and keys get
"
`;

exports[`help > keys --help matches its snapshot 1`] = `
"Usage: alttext keys [options] [command]

Create, rotate, revoke and inspect the account's site API keys

Options:
  -h, --help              Show help

Global Options:
  -v, --version           Print the version
  --json                  Print the result as JSON on stdout
  --no-input              Never prompt; fail instead when input is needed
  --yes                   Run destructive commands without asking for confirmation
  --dry-run               Read the target and show what a change would do, without making it
  --show-tokens           Show full tokens in keys list and keys get

Commands:
  list [options]          List the account's site API keys with usage and limits. Tokens are masked
                          to their last four characters
  get [options] <id>      Get one API key's details, usage and limit. The token is masked; use
                          reveal_api_key_token to see it
  reveal <id>             Show one API key's full token. The reveal is recorded in the key's
                          history. Only use when the person asks for this key's token
  create [options]        Create a site API key, optionally with a per-period credit limit. Returns
                          the new token
  update [options] <id>   Rename an API key or change its per-period credit limit (null removes the
                          limit)
  rotate [options] <id>   Replace an API key's token. The old token stops working immediately.
                          Returns the new token
  revoke [options] <id>   Revoke an API key. Its token stops working immediately; the key and its
                          usage stay readable
  history [options] <id>  List the recorded changes to one API key, newest first, with who made each
"
`;

exports[`help > keys create --help matches its snapshot 1`] = `
"Usage: alttext keys create [options]

Create a site API key, optionally with a per-period credit limit. Returns the new token

Options:
  --name <value>             Key name, such as the client it belongs to
  --usage-limit <n-or-none>  Credits this key may use per billing period; null means unlimited (pass
                             "none" for null)
  --idempotency-key <value>  Reuse the same value when retrying so the change happens once
  -h, --help                 Show help

Global Options:
  -v, --version              Print the version
  --json                     Print the result as JSON on stdout
  --no-input                 Never prompt; fail instead when input is needed
  --yes                      Run destructive commands without asking for confirmation
  --dry-run                  Read the target and show what a change would do, without making it
  --show-tokens              Show full tokens in keys list and keys get
"
`;

exports[`help > keys get --help matches its snapshot 1`] = `
"Usage: alttext keys get [options] <id>

Get one API key's details, usage and limit. The token is masked; use reveal_api_key_token to see it

Arguments:
  id                The API key's ID

Options:
  --detail <value>  full adds usage history, domains and credit periods (default: concise) (choices:
                    "concise", "full")
  -h, --help        Show help

Global Options:
  -v, --version     Print the version
  --json            Print the result as JSON on stdout
  --no-input        Never prompt; fail instead when input is needed
  --yes             Run destructive commands without asking for confirmation
  --dry-run         Read the target and show what a change would do, without making it
  --show-tokens     Show full tokens in keys list and keys get
"
`;

exports[`help > keys history --help matches its snapshot 1`] = `
"Usage: alttext keys history [options] <id>

List the recorded changes to one API key, newest first, with who made each

Arguments:
  id               The API key's ID

Options:
  --after <value>  Cursor from a previous page's next_cursor
  --limit <n>      Items per page (default: 25, max: 100)
  -h, --help       Show help

Global Options:
  -v, --version    Print the version
  --json           Print the result as JSON on stdout
  --no-input       Never prompt; fail instead when input is needed
  --yes            Run destructive commands without asking for confirmation
  --dry-run        Read the target and show what a change would do, without making it
  --show-tokens    Show full tokens in keys list and keys get
"
`;

exports[`help > keys list --help matches its snapshot 1`] = `
"Usage: alttext keys list [options]

List the account's site API keys with usage and limits. Tokens are masked to their last four
